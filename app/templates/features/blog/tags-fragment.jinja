{#import "@ui/tag.jinja" as Tag #}
{#import "@features/blog/card.jinja" as PostCard #}
{#import "@ui/feedback/empty.jinja" as EmptyState #}
{#import "@ui/nav/pagination.jinja" as Pagination #}
{#def tags=(), posts=(), selected_tag="", page=1, total_pages=1 #}

<div id="tag-posts">
    <div class="flex flex-wrap gap-2 mb-6">
        <Tag
            href={{ "/" ~ current_lang ~ "/blog/tags" }}
            text={{ t.pages.blog.all_tags_label }}
            variant={{ "accent" if selected_tag == "" else "outline" }}
            hx-get={{ "/" ~ current_lang ~ "/blog/tags" }}
            hx-target="#tag-posts"
            hx-swap="outerHTML"
            hx-push-url="true"
        />
        {% for tag in tags %}
        <Tag
            href={{ "/" ~ current_lang ~ "/blog/tags/" ~ (tag.name | urlencode) }}
            text={{ tag.name ~ " (" ~ tag.count ~ ")" }}
            variant={{ "accent" if selected_tag and selected_tag | lower == tag.name | lower else "outline" }}
            hx-get={{ "/" ~ current_lang ~ "/blog/tags/" ~ (tag.name | urlencode) }}
            hx-target="#tag-posts"
            hx-swap="outerHTML"
            hx-push-url="true"
        />
        {% endfor %}
    </div>

    <div class="space-y-3 sm:space-y-4">
        {% for post in posts %}
        <PostCard post={{ post }} compact={{ true }} />
        {% else %}
        <EmptyState message={{ t.pages.blog.no_posts_for_tag }} />
        {% endfor %}
    </div>

    {% set base = "/" ~ current_lang ~ "/blog/tags/" ~ (selected_tag | urlencode) ~ "?" if selected_tag else "/" ~ current_lang ~ "/blog/tags?" %}
    <Pagination page={{ page }} total_pages={{ total_pages }} base_url={{ base }} />
</div>
