{#import "@ui/card/card.jinja" as Card #}
{#import "@ui/tag.jinja" as Tag #}
{#import "@ui/nav/section.jinja" as SectionLink #}
{#import "@ui/layout/row.jinja" as Row #}
{#import "@ui/feedback/empty.jinja" as EmptyState #}
{#import "@ui/card/heading.jinja" as CardHeading #}
{#def featured=() #}

<section class="flex flex-col min-h-0">
    <a
        href="/{{ current_lang }}/projects"
        class="group block mb-3"
        data-telemetry-event="click"
        data-telemetry-id="home-projects-heading"
        data-telemetry-label="projects"
        data-telemetry-target="/{{ current_lang }}/projects"
    >
        <h2 class="text-lg font-semibold heading-hover flex items-center gap-2">
            {{ t.pages.projects.title }}
        </h2>
    </a>

    <div class="space-y-3 flex-1 overflow-hidden">
        {% for project in featured %}
        <Card href={{ '/' ~ current_lang ~ '/projects/' ~ project.slug }} padding="sm">
            <div class="flex flex-col gap-1">
                <CardHeading title={{ project.title }} date={{ project.date }} featured={{ project.featured }} featured_label={{ t.pages.projects.featured_label }} title_class="text-sm text-foreground font-medium group-hover:text-accent transition-colors" featured_class="text-accent" />
                <p class="text-xs text-foreground/50 line-clamp-1">{{ project.description }}</p>
                <Row wrap={{ true }} gap="1.5" class_name="mt-1">
                    {% for tech in (project.tech_stack if project.tech_stack else project.tags)[:3] %}
                    <Tag text={{ tech }} variant="outline" />
                    {% endfor %}
                </Row>
            </div>
        </Card>
        {% else %}
        <EmptyState message={{ t.empty_states.projects }} />
        {% endfor %}
    </div>

    <div class="mt-3">
        <SectionLink href={{ "/" ~ current_lang ~ "/projects" }} label={{ t.cta.view_all_projects }} data-telemetry-event="click" data-telemetry-id="section-link-view-all-projects" data-telemetry-label={{ t.cta.view_all_projects }} data-telemetry-target={{ "/" ~ current_lang ~ "/projects" }} />
    </div>
</section>
