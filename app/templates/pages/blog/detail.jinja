{#import "@layouts/public.jinja" as PublicLayout #}
{#import "@ui/nav/breadcrumb.jinja" as Breadcrumb #}
{#import "@ui/tag.jinja" as Tag #}
{#import "@ui/layout/row.jinja" as Row #}
{#import "@ui/content/shell.jinja" as ContentShell #}
{#import "@ui/content/meta.jinja" as MetaInfo #}
{#import "@ui/card/card.jinja" as Card #}
{#import "@features/blog/comments.jinja" as GithubComments #}
{#def seo, post, previous_post=None, next_post=None, read_time_minutes=1, current_path="/blog" #}

<PublicLayout seo={{ seo }} current_path={{ current_path }}>
    {% set comment_source_label = t.comments.source_gist if post.gist_id else t.comments.source_github %}
    {% set breadcrumb_items = (
        {"label": t.common.home, "href": "/" ~ current_lang ~ "/"},
        {"label": t.pages.blog.title, "href": "/" ~ current_lang ~ "/blog"},
        {"label": post.title, "current": true},
    ) %}

    <div
        class="reading-progress"
        data-controller="reading-progress"
        data-reading-progress-content-selector-value="[data-post-content]"
        aria-hidden="true"
    >
        <div class="reading-progress__bar" data-reading-progress-target="bar"></div>
    </div>

    <div class="space-y-8 sm:space-y-10">
        <div class="space-y-4 sm:space-y-6">
            <Breadcrumb items={{ breadcrumb_items }} class_name="text-sm text-foreground/50 -mt-2 sm:-mt-3 fade-in flex items-center" />

            <article class="space-y-8">
                <header>
                    <div class="max-w-3xl">
                        <MetaInfo>
                            {% if post.date %}
                            <span>{{ post.date.strftime("%B %d, %Y") }}</span>
                            {% endif %}
                            {% if post.author %}
                            <span>&bull;</span>
                            <span>{{ post.author }}</span>
                            {% endif %}
                            <span>&bull;</span>
                            <span>{{ read_time_minutes }} {{ t.pages.blog.min_read }}</span>
                            {% if post.featured %}
                            <span>&bull;</span>
                            <span class="text-accent">{{ t.pages.blog.featured_label }}</span>
                            {% endif %}
                        </MetaInfo>

                        <h1 class="text-4xl font-bold text-foreground mb-4 sm:mb-5 leading-tight">{{ post.title }}</h1>

                        {% if post.description %}
                        <p class="text-xl text-foreground/60">{{ post.description }}</p>
                        {% endif %}

                        {% if post.tags %}
                        <Row wrap={{ true }} gap="2" class_name="mt-4">
                            {% for tag in post.tags %}
                            <Tag href={{ "/" ~ current_lang ~ "/blog/tags/" ~ (tag | urlencode) }} text={{ tag }} variant="outline" />
                            {% endfor %}
                        </Row>
                        {% endif %}
                    </div>
                </header>

                <ContentShell content_class="prose">
                    {{ post.content_html | safe }}
                </ContentShell>
            </article>
        </div>

        <div class="max-w-3xl">
            <GithubComments
                discussion_url={{ post.discussion_url }}
                post_title={{ post.title }}
                comments={{ post.comments }}
                comment_source_label={{ comment_source_label }}
                show_cta={{ true }}
            />
        </div>

        {% if previous_post or next_post %}
        <section class="max-w-3xl section-divider-spacing border-t border-border/50">
            <div class="flex items-center justify-between mb-5">
                <h2 class="text-xl sm:text-2xl font-bold text-foreground">{{ t.pages.blog.continue_reading }}</h2>
                <a href="/{{ current_lang }}/blog/posts" class="text-sm link-hover">{{ t.pages.blog.view_all_posts_arrow }}</a>
            </div>
            <nav class="grid grid-cols-1 sm:grid-cols-2 gap-3" aria-label="Post navigation">
                {% if previous_post %}
                <Card href={{ '/' ~ current_lang ~ '/blog/posts/' ~ previous_post.slug }} padding="sm">
                    <div class="space-y-1.5">
                        <span class="text-xs text-foreground/50">{{ t.pages.blog.previous_post }}</span>
                        <p class="text-sm font-semibold text-foreground group-hover:text-accent transition-colors line-clamp-1">{{ previous_post.title }}</p>
                        {% if previous_post.description %}
                        <p class="text-xs text-foreground/50 leading-relaxed line-clamp-1">{{ previous_post.description }}</p>
                        {% endif %}
                    </div>
                </Card>
                {% else %}
                <div></div>
                {% endif %}
                {% if next_post %}
                <Card href={{ '/' ~ current_lang ~ '/blog/posts/' ~ next_post.slug }} padding="sm">
                    <div class="space-y-1.5">
                        <span class="text-xs text-foreground/50 block text-right">{{ t.pages.blog.next_post }}</span>
                        <p class="text-sm font-semibold text-foreground group-hover:text-accent transition-colors line-clamp-1">{{ next_post.title }}</p>
                        {% if next_post.description %}
                        <p class="text-xs text-foreground/50 leading-relaxed line-clamp-1">{{ next_post.description }}</p>
                        {% endif %}
                    </div>
                </Card>
                {% else %}
                <div></div>
                {% endif %}
            </nav>
        </section>
        {% endif %}
    </div>
</PublicLayout>
