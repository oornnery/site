{#import "@layouts/public.jinja" as PublicLayout #}
{#import "@ui/form/button.jinja" as Button #}
{#import "@ui/icon.jinja" as Icon #}
{#import "@ui/layout/center.jinja" as Center #}
{#import "@ui/layout/row.jinja" as Row #}
{#def seo, current_path="", message="We are performing maintenance right now. Please try again in a few minutes." #}

<PublicLayout seo={{ seo }} current_path={{ current_path }}>
    <Center>
        <p class="text-sm text-foreground/50 mb-3">{{ t.error_pages.maintenance.label }}</p>
        <h1 class="text-4xl sm:text-5xl font-bold text-foreground mb-4 inline-flex items-center justify-center gap-2">
            <Icon name="check" size="lg" class_name="text-accent" />
            {{ t.error_pages.maintenance.title }}
        </h1>
        <p class="text-base text-foreground/60 mb-8 max-w-xl mx-auto">{{ message }}</p>
        <Row gap="3" justify="center">
            <Button href="/" variant="primary">{{ t.error_pages.maintenance.retry }}</Button>
            <Button href={{ "/" ~ current_lang ~ "/contact" }} variant="secondary">{{ t.error_pages.maintenance.contact }}</Button>
        </Row>
    </Center>
</PublicLayout>
