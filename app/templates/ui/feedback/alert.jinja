{#import "@ui/icon.jinja" as Icon #}
{#def message="", tone="info", role="" #}

{% if message %}
{% set tones = {
    "info": "text-interactive border-interactive/30 bg-interactive/10",
    "success": "text-success border-success/30 bg-success/10",
    "danger": "text-danger border-danger/30 bg-danger/10",
    "warning": "text-warn border-warn/30 bg-warn/10"
} %}
{% set tone_icons = {
    "info": "info-circle",
    "success": "check-circle",
    "danger": "x-circle",
    "warning": "alert-triangle"
} %}
{% set default_role = "alert" if tone in ("danger", "warning") else "status" %}
<div class="flex items-center p-3 text-sm rounded-lg border {{ tones.get(tone, tones.info) }}" role="{{ role or default_role }}" {{ attrs.render() }}>
    <Icon name={{ tone_icons.get(tone, "info-circle") }} size="sm" class_name="shrink-0 me-2" />
    <span>{{ message }}</span>
</div>
{% endif %}
